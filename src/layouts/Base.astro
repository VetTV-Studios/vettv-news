---
import { SITE, SOCIALS, CAT_DESC, NAV_PRIMARY, NAV_MORE, url, asset } from '../site';
import '../styles/global.css';
import Subscribe from '../components/Subscribe.astro';
const { title, seoTitle, description = SITE.tagline, image, type = 'website', active = '', noindex = false, newsletter = true } = Astro.props;
const fullTitle = seoTitle ? `${seoTitle} | ${SITE.name}` : title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(asset(image || 'brand/og-default-1200x630.png'), Astro.site);
const reviewsOn = active === 'reviews' || active === 'guides';
const moreOn = NAV_MORE.some(([k]) => k === active);
const showNews = newsletter && active !== 'subscribe';
const FOOT: [string, [string, string][]][] = [
  ['Sections', [['News', 'news'], ['Gaming', 'gaming'], ['Tech', 'tech'], ['AI', 'ai'], ['Handhelds', 'handhelds'], ['Reviews', 'reviews'], ['Guides', 'guides']]],
  ['More', NAV_MORE.filter(([k]) => !['upcoming', 'soft-launches', 'delistings', 'tags', 'videos'].includes(k)).map(([k, v]) => [v, k])],
  ['The desk', [['Upcoming', 'upcoming'], ['Soft Launches', 'soft-launches'], ['Delistings', 'delistings'], ['Tags', 'tags'], ['Videos', 'videos'], ['VetTV Bots', 'https://vettvstudios.com/bots'], ['About', 'about'], ['Contact', 'contact']]],
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><meta name="facebook-domain-verification" content="o6wa56h6e10mu8r63ya5m5sgll9f2t" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<link rel="icon" href={asset('favicon.ico')} sizes="any" /><link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32.png')} /><link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} /><link rel="manifest" href={asset('site.webmanifest')} />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href={asset('rss.xml')} />
<link rel="sitemap" href={asset('sitemap-index.xml')} />
<meta property="og:site_name" content={SITE.name} /><meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} /><meta property="og:type" content={type} />
<meta property="og:url" content={canonical} /><meta property="og:image" content={og} />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={og} />
<meta name="theme-color" content="#ffffff" />
<script is:inline async src="https://news.google.com/swg/js/v1/publisher.js"></script>
<slot name="head" />
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="top">
  <div class="accent-bar" aria-hidden="true"></div>
  <div class="wrap bar">
    <a class="brand" href={url('')}><img class="brand-logo" src={asset('brand/vettv-studios-logo-transparent.svg')} alt="" width="78" height="44" /><span>VetTV <b>News</b></span></a>
    <nav class="primary" aria-label="Sections">
      {NAV_PRIMARY.map(([k, v]) => <a class={`nav-a ${active === k ? 'on' : ''}`} href={k === 'ai' ? url('ai') : url(k)}>{v}</a>)}
      <div class="drop">
        <button type="button" aria-expanded="false" aria-haspopup="true" class={reviewsOn ? 'on' : ''}>Reviews</button>
        <div class="drop-menu" role="group" aria-label="Reviews and guides">
          <a class={active === 'reviews' ? 'on' : ''} href={url('reviews')}>Reviews</a>
          <a class={active === 'guides' ? 'on' : ''} href={url('guides')}>Guides</a>
        </div>
      </div>
      <div class="drop">
        <button type="button" aria-expanded="false" aria-haspopup="true" class={moreOn ? 'on' : ''}>More</button>
        <div class="drop-menu" role="group" aria-label="More sections">
          {NAV_MORE.map(([k, v]) => <a class={active === k ? 'on' : ''} href={url(k)}>{v}</a>)}
        </div>
      </div>
    </nav>
    <form class="qs" action={url('search')} role="search"><input name="q" type="search" placeholder="Search" aria-label="Search" /></form>
    <a class="sub-btn" href={url('subscribe')}>Subscribe</a>
    <a class="icon-btn m-search" href={url('search')} aria-label="Search"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></a>
    <button class="icon-btn menu" aria-label="Menu" aria-controls="m-drawer" aria-expanded="false" onclick="vhnNav()">☰</button>
  </div>
</header>
<div class="m-drawer" id="m-drawer" aria-label="Sections">
  <p class="m-drawer-h">Sections</p>
  {NAV_PRIMARY.map(([k, v]) => <a class={`m-sec ${active === k ? 'on' : ''}`} href={k === 'ai' ? url('ai') : url(k)}><b>{v}</b><small>{k === 'ai' ? 'Models, assistants, and the companies shipping them.' : CAT_DESC[k]}</small></a>)}
  <a class={`m-sec ${active === 'reviews' ? 'on' : ''}`} href={url('reviews')}><b>Reviews</b><small>Reviews from every section.</small></a>
  <a class={`m-sec ${active === 'guides' ? 'on' : ''}`} href={url('guides')}><b>Guides</b><small>Hands-on setup notes and explainers.</small></a>
  <p class="m-drawer-h">More</p>
  {NAV_MORE.map(([k, v]) => <a class={`m-sec ${active === k ? 'on' : ''}`} href={url(k)}><b>{v}</b>{CAT_DESC[k] && <small>{CAT_DESC[k]}</small>}</a>)}
  <div class="m-drawer-links"><a href={url('subscribe')}>Subscribe</a><a href={asset('rss.xml')}>RSS</a><a href={SITE.youtube}>YouTube</a><a href="https://vettvstudios.com/bots" rel="noopener">VetTV Bots</a></div>
</div>
<main class="wrap" id="content"><slot /></main>
{showNews && <div class="news-strip"><div class="wrap"><Subscribe id="foot-sub" compact heading="Get the VetTV News weekly" /></div></div>}
<footer class="foot">
  <div class="wrap foot-in">
    <div class="foot-brand">
      <a class="brand" href={url('')}><img src={asset('brand/vettv-studios-logo-transparent.svg')} alt="" width="78" height="44" /><span>VetTV <b>News</b></span></a>
      <p>{SITE.tagline}</p>
      <ul class="socials" aria-label="VetTV channels">
        {SOCIALS.map(x => <li><a href={x.href} aria-label={`VetTV on ${x.name} (${x.handle})`} rel="me noopener"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={x.d} /></a></li>)}
        <li><a href={asset('rss.xml')} aria-label="RSS feed"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5.5" cy="18.5" r="2.2" fill="currentColor"/><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></a></li>
      </ul>
    </div>
    {FOOT.map(([h, links]) => <nav class="foot-grp" aria-label={h}><h2>{h}</h2><ul>{links.map(([l, p]) => <li><a href={p.startsWith('http') ? p : url(p)}>{l}</a></li>)}</ul></nav>)}
    <div class="preferred-source"><div google-add-preferred-source-btn></div></div>
    <p class="foot-copy"><img src={asset('art/watermark_150x150.png')} alt="" width="28" height="28" />© {new Date().getFullYear()} VetTV Studios · Independent coverage. Not affiliated with Valve, ASUS, Lenovo, Microsoft, Apple or SteamDeckHQ. · <a href={url('privacy')}>Privacy</a> · <a href={url('terms')}>Terms</a> · <a href={url('affiliate-disclosure')}>Affiliate disclosure</a> · <a href={url('content-disclosure')}>Content disclosure</a></p>
  </div>
</footer>
<script is:inline>
  function vhnNav(){var o=document.body.classList.toggle('nav-open');document.querySelectorAll('[aria-controls="m-drawer"]').forEach(function(b){b.setAttribute('aria-expanded',o)});}
  addEventListener('keydown',function(e){if(e.key==='Escape'){document.body.classList.remove('nav-open');document.querySelectorAll('.drop.open').forEach(function(d){d.classList.remove('open');var b=d.querySelector('button');if(b)b.setAttribute('aria-expanded','false');});}});
  document.querySelectorAll('.drop > button').forEach(function(btn){
    btn.addEventListener('click',function(e){e.stopPropagation();var open=btn.parentElement.classList.contains('open');
      document.querySelectorAll('.drop.open').forEach(function(d){d.classList.remove('open');var b=d.querySelector('button');if(b)b.setAttribute('aria-expanded','false');});
      if(!open){btn.parentElement.classList.add('open');btn.setAttribute('aria-expanded','true');}});
  });
  addEventListener('click',function(e){if(!e.target.closest('.drop'))document.querySelectorAll('.drop.open').forEach(function(d){d.classList.remove('open');var b=d.querySelector('button');if(b)b.setAttribute('aria-expanded','false');});});
</script>
</body></html>
