---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryIndex from '../components/StoryIndex.astro';
import { CATS, CAT_DESC, sortPosts } from '../site';
export async function getStaticPaths() {
  const all = await getCollection('posts', ({ data }) => !data.draft || process.env.SHOW_DRAFTS === '1');
  return Object.keys(CATS).map((category) => ({ params: { category }, props: { posts: sortPosts(category === 'news' ? all : all.filter((p) => p.data.category === category)) } }));
}
const { category } = Astro.params;
const { posts } = Astro.props;
const disclosure = category === 'open-nt' ? 'Disclosure: VetTV develops VetTV Retro OS, a fork of ReactOS that is still in development.' : '';
---
<Base title={CATS[category]} description={CAT_DESC[category]} active={category}>
  <StoryIndex kicker="Section" title={CATS[category]} description={CAT_DESC[category]} posts={posts} disclosure={disclosure} empty={`${CATS[category]} stories are on the way`} />
</Base>
