---
// Content-type page (was a section before the Oct 2026 redesign; URL kept).
// Reviews are a post type, not a schema section, so the nav item opens this page and Guides.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryIndex from '../components/StoryIndex.astro';
import { sortPosts } from '../site';
const description = 'Reviews from every section. Posts marked as reviews land here; there is no separate reviews category.';
const posts = sortPosts((await getCollection('posts', ({ data }) => !data.draft || process.env.SHOW_DRAFTS === '1')).filter((p) => p.data.type === 'review'));
---
<Base title="Reviews" description={description} active="reviews">
  <StoryIndex kicker="Type" title="Reviews" description={description} posts={posts} empty="No reviews yet" />
</Base>
