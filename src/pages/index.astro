---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { CATS, TYPE_LABEL, url, asset, fmt, sortPosts, coverFile } from '../site';
import { TRACKERS, sortRows, when } from '../tracker';
const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft || process.env.SHOW_DRAFTS === '1'));
const lead = posts[0];
const secondary = posts.slice(1, 5);
const river = posts.slice(5, 29);
const trk = await Promise.all(Object.entries(TRACKERS).map(async ([k, T]) => [k, T, sortRows(await getCollection(T.coll as any))] as const));
const tl = (p: { data: { type?: string } }) => (p.data.type && p.data.type !== 'news' ? p.data.type : '');
---
<Base>
  <section class="hero-row" aria-label="Top stories">
    <article class="hero-lead">
      <a class="hero-lead-media" href={url(`posts/${lead.id}`)}><img src={asset(coverFile(lead))} alt="" width="1200" height="675" fetchpriority="high" /></a>
      <div class="hero-lead-copy">
        <div class="meta"><a class={`kick cat-${lead.data.category}`} href={url(lead.data.category)}>{CATS[lead.data.category]}</a>{tl(lead) && <span class={`type type-${tl(lead)}`}>{TYPE_LABEL[tl(lead)]}</span>}</div>
        <h1><a href={url(`posts/${lead.id}`)}>{lead.data.title}</a></h1>
        <p>{lead.data.description}</p>
        <div class="meta byline"><span class="by">{lead.data.author}</span><time datetime={lead.data.pubDate.toISOString()}>{fmt(lead.data.pubDate)}</time></div>
      </div>
    </article>
    <div class="hero-side">
      {secondary.map((p) => (
        <a class="hero-sec" href={url(`posts/${p.id}`)}>
          <img src={asset(coverFile(p))} alt="" width="1200" height="675" />
          <span>
            <span class={`kick cat-${p.data.category}`}>{CATS[p.data.category]}</span>
            <strong>{p.data.title}</strong>
            <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="latest" aria-labelledby="latest-h">
    <h2 class="sec" id="latest-h"><span>Latest</span><a class="sec-cta" href={url('news')}>All stories</a></h2>
    <div class="river">{river.map((p) => <Card post={p} variant="river" />)}</div>
    <a class="more-link" href={url('news')}>All stories</a>
  </section>

  <section class="trackers" aria-labelledby="trackers-h">
    <h2 class="sec" id="trackers-h"><span>Trackers</span></h2>
    <div class="trk-grid">{trk.map(([, T, rows]) => (
      <section class="trk-mod">
        <h3><a href={url(T.path)}>{T.name}</a></h3>
        <p class="muted">{T.desc}</p>
        <ul class="trk-list">
          {rows.slice(0, 5).map(({ data: d }) => (
            <li>
              <span class={`st st-${d.status.toLowerCase()}`}>{d.status}</span>
              <b>{d.title}</b>
              <span class="trk-when">{when(d)}</span>
            </li>
          ))}
        </ul>
        <a class="trk-cta" href={url(T.path)}>View tracker ({rows.length})</a>
      </section>
    ))}</div>
  </section>
</Base>
