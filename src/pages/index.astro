---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro'; import Card from '../components/Card.astro'; import Tracker from '../components/Tracker.astro';
import { CATS, CAT_DESC, TYPE_LABEL, url, asset, coverSrc, coverSrcset, fmt, ago, sortPosts, mostRead, publishedOn, pickFeaturedPost, isFeaturedEligible, HOME_FEED_SIZE } from '../site'; import { TRACKERS, sortRows } from '../tracker';
const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft || process.env.SHOW_DRAFTS === '1'));
// Featured slot: newest still-eligible featured:true post, else the latest published story so the slot never goes stale.
const lead = pickFeaturedPost(posts) ?? posts[0];
const feed = posts.filter(p => p.id !== lead.id).slice(0, HOME_FEED_SIZE);
const secondary = feed.slice(0, 4);
const latest = feed.slice(4);
const featuredLive = isFeaturedEligible(lead);
const popular = mostRead(posts, undefined, 6);
const guides = posts.filter(p => p.data.type === 'guide').slice(0, 4);
const reviews = posts.filter(p => p.data.type === 'review').slice(0, 4);
const deals = posts.filter(p => p.data.category === 'deals' || p.data.type === 'deal').slice(0, 4);
const rails = Object.keys(CATS).filter(k => k !== 'news' && k !== 'deals').map(k => [k, posts.filter(p => p.data.category === k).slice(0, 4)] as const).filter(([, ps]) => ps.length >= 2);
const trk = await Promise.all(Object.entries(TRACKERS).map(async ([k, T]) => [k, T, sortRows(await getCollection(T.coll as any))] as const));
const tl = (p: any) => p.data.type !== 'news' ? p.data.type : '';
const ticker = posts.slice(0, 6);
---
<Base>
  {lead.data.cover && <link slot="head" rel="preload" as="image" imagesrcset={coverSrcset(lead.data.cover)} imagesizes="(max-width:900px) 100vw, 800px" fetchpriority="high" />}
  <div class="ticker" aria-label="Latest headlines">
    <span class="ticker-tag">Latest</span>
    <div class="ticker-scroll">{ticker.map(p => <a href={url(`posts/${p.id}`)}><span class="kick">{CATS[p.data.category]}</span> {p.data.title}</a>)}</div>
  </div>

  <section class="top-stories" aria-label="Top stories">
    <article class="lead-story">
      <a class="lead-media" href={url(`posts/${lead.id}`)}>
        <img src={coverSrc(lead.data.cover || 'art/banner_2560x1440.png', 960)} srcset={lead.data.cover ? coverSrcset(lead.data.cover) : undefined} sizes="(max-width:900px) 100vw, 800px" alt="" width="1200" height="675" fetchpriority="high" />
        <span class="badges"><span class="pill feat">{featuredLive ? "Featured" : "Top story"}</span><span class="pill">{CATS[lead.data.category]}</span>{tl(lead) && <span class={`type type-${tl(lead)}`}>{TYPE_LABEL[tl(lead)]}</span>}</span>
      </a>
      <div class="lead-copy">
        <h1><a href={url(`posts/${lead.id}`)}>{lead.data.title}</a></h1>
        <p>{lead.data.description}</p>
        <div class="meta"><span class="by">{lead.data.author}</span><time datetime={publishedOn(lead.data).toISOString()}>{ago(publishedOn(lead.data))}</time></div>
      </div>
    </article>
    <div class="top-side">
      {secondary.map(p => (
        <article class="top-sec">
          <a class="thumb" href={url(`posts/${p.id}`)} aria-label={p.data.title}><img src={coverSrc(p.data.cover || 'art/banner_2560x1440.png', 640)} srcset={p.data.cover ? coverSrcset(p.data.cover, [320, 640]) : undefined} sizes="(max-width:700px) 120px, 210px" alt="" loading="lazy" width="480" height="270" /></a>
          <div>
            <div class="meta"><a class="kick" href={url(p.data.category)}>{CATS[p.data.category]}</a>{tl(p) && <span class={`type type-${tl(p)}`}>{TYPE_LABEL[tl(p)]}</span>}</div>
            <h2><a href={url(`posts/${p.id}`)}>{p.data.title}</a></h2>
            <div class="meta"><time datetime={publishedOn(p.data).toISOString()}>{ago(publishedOn(p.data))}</time></div>
          </div>
        </article>))}
    </div>
  </section>

  <div class="home-desk">
    <div class="home-main">
      <h2 class="sec"><span>Latest stories</span><a class="sec-cta" href={url('archive')}>Full archive →</a></h2>
      <div class="river">{latest.map(p => <Card post={p} variant="river" />)}</div>
      <a class="more-link" href={url('archive')}>View full archive</a>

      {(guides.length > 0 || reviews.length > 0) && (
        <section class="duo" aria-label="Guides and reviews">
          {guides.length > 0 && <div><h2 class="sec"><span>Guides</span><a class="sec-cta" href={url('guides')}>All guides →</a></h2>{guides.map(p => <Card post={p} variant="compact" />)}</div>}
          {reviews.length > 0 && <div><h2 class="sec"><span>Reviews</span><a class="sec-cta" href={url('reviews')}>All reviews →</a></h2>{reviews.map(p => <Card post={p} variant="compact" />)}</div>}
        </section>)}
    </div>
    <aside class="rail">
      <div class="rail-block"><h2 class="rail-title">Most read <small>editor picks first</small></h2>{popular.map((p, i) => <Card post={p} variant="rank" n={i + 1} />)}</div>
      <div class="rail-block rail-sub">
        <h2 class="rail-title">The Sunday brief</h2>
        <p>One email a week with the biggest VetTV News stories across news, tech and gaming.</p>
        <a class="rail-btn" href={url('subscribe')}>Get it free</a>
        <p class="muted rail-fine">Prefer a feed? <a href={asset('rss.xml')}>Grab the RSS</a>.</p>
      </div>
      <div class="rail-block"><h2 class="rail-title">Sections</h2><ul class="rail-secs">{Object.entries(CATS).filter(([k]) => k !== 'news').map(([k, v]) => <li><a href={url(k)}>{v}</a></li>)}<li><a href={url('videos')}>Videos</a></li><li><a href={url('archive')}>Archive</a></li></ul></div>
    </aside>
  </div>

  {deals.length > 0 && (
    <section class="sec-row deals-row"><h2 class="sec"><span>Deals worth your time</span><a class="sec-cta" href={url('deals')}>All deals →</a></h2>
      <p class="sec-desc">{CAT_DESC['deals']}</p>
      <div class="row-scroller">{deals.map(p => <Card post={p} />)}</div></section>)}

  <section class="trackers"><h2 class="sec"><span>Trackers</span></h2>
    <p class="sec-desc">Release dates, soft launches and shutdowns we keep an eye on, each row checked against its source.</p>
    <div class="trk-grid">{trk.map(([k, T, rows]) => (
      <div class="trk-mod"><h3><a href={url(T.path)}>{T.name}</a></h3><p class="muted">{T.desc}</p>
        <Tracker rows={rows} kind={k} limit={5} /><a class="trk-cta" href={url(T.path)}>View tracker ({rows.length}) →</a></div>))}</div>
  </section>

  {rails.map(([k, ps]) => (
    <section class="sec-row"><h2 class="sec"><span>{CATS[k]}</span><a class="sec-cta" href={url(k)}>More {CATS[k]} →</a></h2>
      <p class="sec-desc">{CAT_DESC[k]}</p>
      <div class="row-scroller">{ps.map(p => <Card post={p} />)}</div></section>))}
</Base>
