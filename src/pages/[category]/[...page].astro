---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Pagination from '../../components/Pagination.astro';
import { CATS, CAT_DESC, TYPE_LABEL, sortPosts, mostRead, url, CATEGORY_PAGE_SIZE } from '../../site';

export async function getStaticPaths({ paginate }) {
  const all = sortPosts(await getCollection('posts', ({ data }) => !data.draft || process.env.SHOW_DRAFTS === '1'));
  const paths = [];
  for (const category of Object.keys(CATS)) {
    const list = category === 'news' ? [...all] : all.filter((p) => p.data.category === category);
    if (list.length === 0) {
      paths.push({
        params: { category, page: undefined },
        props: {
          all,
          page: {
            data: [],
            currentPage: 1,
            lastPage: 1,
            size: CATEGORY_PAGE_SIZE,
            total: 0,
            start: 0,
            end: 0,
            url: { current: url(category) },
          },
        },
      });
    } else {
      paths.push(...paginate(list, { params: { category }, pageSize: CATEGORY_PAGE_SIZE, props: { all } }));
    }
  }
  return paths;
}

const { category } = Astro.params;
const { page, all } = Astro.props;
const posts = page.data;
const [lead, ...rest] = posts;
const types = [...new Set(posts.map((p) => p.data.type))].filter((t) => t !== 'news');
const popular = mostRead(all, undefined, 5);
const title = page.currentPage > 1 ? `${CATS[category]} · page ${page.currentPage}` : CATS[category];
---
<Base title={title} description={CAT_DESC[category]} active={category}>
  <header class="page-head">
    <p class="kicker">{category === 'news' ? 'Every desk' : 'Section'}</p>
    <h1 class="page-h">{CATS[category]}</h1>
    <p class="cat-desc">{CAT_DESC[category]}</p>
    {category === 'open-nt' && <p class="disclosure"><em>Disclosure: VetTV develops VetTV Retro OS, a fork of ReactOS that is still in development.</em></p>}
    <p class="muted stat">{page.total} {page.total === 1 ? 'story' : 'stories'}{page.lastPage > 1 && <> · page {page.currentPage} of {page.lastPage}</>}{category !== 'news' && <> · <a href={url('news')}>See everything in News</a></>}</p>
    {types.length > 0 && (
      <div class="filter-chips" data-filter-chips role="group" aria-label="Filter by story type">
        <button type="button" class="chip on" data-filter="all">All</button>
        <button type="button" class="chip" data-filter="news">{TYPE_LABEL.news}</button>
        {types.map((t) => <button type="button" class="chip" data-filter={t}>{TYPE_LABEL[t]}</button>)}
      </div>)}
  </header>
  {posts.length ? (
    <div class="cat-desk">
      <div>
        <div data-type={lead.data.type}><Card post={lead} big /></div>
        {rest.length > 0 && <div class="river cat-river">{rest.map((p) => <div data-type={p.data.type}><Card post={p} variant="river" /></div>)}</div>}
        <Pagination page={page} base={category} />
      </div>
      <aside class="rail">
        <div class="rail-block"><h2 class="rail-title">Most read</h2>{popular.map((p, i) => <Card post={p} variant="rank" n={i + 1} />)}</div>
        <div class="rail-block"><h2 class="rail-title">More sections</h2><ul class="rail-secs">{Object.entries(CATS).filter(([k]) => k !== category).map(([k, v]) => <li><a href={url(k)}>{v}</a></li>)}</ul></div>
      </aside>
    </div>
  ) : <div class="empty-state"><p class="empty-kick">Nothing here yet</p><h2>{CATS[category]} stories are on the way</h2><p>We haven't published in this section yet. In the meantime, catch up on the latest from across VetTV News.</p><a class="empty-btn" href={url('news')}>Browse all news</a></div>}
  <script is:inline>
    (function () {
      var chips = document.querySelector('[data-filter-chips]');
      if (!chips) return;
      chips.addEventListener('click', function (e) {
        var b = e.target.closest('[data-filter]'); if (!b) return;
        chips.querySelectorAll('.chip').forEach(function (c) { c.classList.toggle('on', c === b); });
        var f = b.getAttribute('data-filter');
        document.querySelectorAll('[data-type]').forEach(function (el) {
          el.hidden = f !== 'all' && el.getAttribute('data-type') !== f;
        });
      });
    })();
  </script>
</Base>
