---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Subscribe from '../../components/Subscribe.astro';
import BotsCard from '../../components/BotsCard.astro';
import { CATS, TYPE_LABEL, url, asset, fmt, sortPosts, readMins, publishedOn, coverFile, mostRead } from '../../site';
export async function getStaticPaths() {
  return (await getCollection('posts', ({ data }) => !data.draft || process.env.SHOW_DRAFTS === '1')).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const all = sortPosts(await getCollection('posts', ({ data }) => !data.draft || process.env.SHOW_DRAFTS === '1')).filter((p) => p.id !== post.id);
const related = [...all.filter((p) => p.data.category === d.category), ...all.filter((p) => p.data.category !== d.category && p.data.tags.some((t) => d.tags.includes(t)))].slice(0, 4);
const canon = new URL(Astro.url.pathname, Astro.site).href;
const enc = encodeURIComponent;
const t = d.type !== 'news' ? d.type : '';
const published = publishedOn(d);
const logoUrl = new URL(asset('favicon-512.png'), Astro.site).href;
const imagePath = coverFile(post);
const imageUrl = new URL(asset(imagePath), Astro.site).href;
const authorLd = { '@type': 'Person', name: /^Vet\b/.test(d.author) ? 'Vet' : d.author, affiliation: { '@type': 'Organization', name: 'VetTV Studios' } };
const ld = {
  '@context': 'https://schema.org',
  '@type': d.type === 'opinion' ? 'OpinionNewsArticle' : d.type === 'review' ? 'Review' : 'NewsArticle',
  headline: d.title,
  description: d.description,
  datePublished: published.toISOString(),
  dateModified: published.toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canon },
  articleSection: CATS[d.category],
  keywords: d.tags.join(', '),
  author: authorLd,
  publisher: { '@type': 'Organization', name: 'VetTV News', legalName: 'VetTV Studios', logo: { '@type': 'ImageObject', url: logoUrl } },
  image: imageUrl,
  citation: d.sources.length ? d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })) : undefined,
};
const popular = mostRead(all, post.id, 6);
---
<Base title={d.title} seoTitle={d.seoTitle} description={d.description} image={imagePath} type="article" active={d.category} newsletter={false}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <div class="post-wrap" data-pagefind-body>
    <header class="post-head">
      <nav class="crumbs" data-pagefind-ignore aria-label="Breadcrumb"><a href={url('')}>Home</a><span aria-hidden="true">/</span><a href={url(d.category)}>{CATS[d.category]}</a></nav>
      <div class="meta kicker-row" data-pagefind-ignore><a class={`kick cat-${d.category}`} href={url(d.category)}>{CATS[d.category]}</a>{t && <span class={`type type-${t}`}>{TYPE_LABEL[t]}</span>}{d.sample && <span class="pill sample">Sample</span>}</div>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      {d.type === 'opinion' && <p class="opinion-note" data-pagefind-ignore>Opinion: this piece is the author's view, not straight news.</p>}
      <div class="byline-card" data-pagefind-ignore>
        <img src={asset('art/profile_800x800.png')} alt="" width="44" height="44" />
        <div><b>By {d.author}</b><span><time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time> · {readMins(post.body)} min read</span></div>
        <div class="share" aria-label="Share">
          <button type="button" onclick={`navigator.clipboard&&navigator.clipboard.writeText('${canon}');this.textContent='Copied'`}>Copy link</button>
          <a href={`https://x.com/intent/post?url=${enc(canon)}&text=${enc(d.title)}`}>X</a>
          <a href={`https://bsky.app/intent/compose?text=${enc(d.title + ' ' + canon)}`}>Bluesky</a>
          <a href={`https://www.reddit.com/submit?url=${enc(canon)}&title=${enc(d.title)}`}>Reddit</a>
        </div>
      </div>
    </header>
    <img class="cover-wide" src={asset(imagePath)} alt="" width="1200" height="675" data-pagefind-ignore />
    <div class="article-frame">
      <article class="post">
        <div class="prose"><Content /></div>
        {d.sources.length > 0 && <section class="sources" aria-labelledby="sources-h"><h2 id="sources-h">Sources</h2><ol>{d.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a> <span class="src-host">{new URL(s.url).hostname.replace(/^www\./, '')}</span></li>)}</ol></section>}
        <p class="tags">{d.tags.map((tag) => <a class="tag" href={url(`tags/${tag}`)}>#{tag}</a>)}</p>
        <div class="preferred-source"><div google-add-preferred-source-btn></div></div>
        <BotsCard />
        <div class="post-sub"><Subscribe id="post-sub" heading="Get the next stories by email" /></div>
      </article>
      <aside class="rail post-rail" data-pagefind-ignore>
        <div class="rail-block">
          <h2 class="rail-title">Most read <small>Staff picks</small></h2>
          <ol class="mostread">{popular.map((p) => <Card post={p} variant="most" />)}</ol>
        </div>
      </aside>
    </div>
    {related.length > 0 && (
      <section class="related" aria-labelledby="related-h" data-pagefind-ignore>
        <h2 class="sec" id="related-h"><span>Related</span></h2>
        <div class="river">{related.map((p) => <Card post={p} variant="river" />)}</div>
      </section>
    )}
  </div>
</Base>
