---
// Content-type page (was a section before the Oct 2026 redesign; URL kept).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryIndex from '../components/StoryIndex.astro';
import { sortPosts } from '../site';
const description = 'Hands-on setup notes and explainers from every section.';
const posts = sortPosts((await getCollection('posts', ({ data }) => !data.draft || process.env.SHOW_DRAFTS === '1')).filter((p) => p.data.type === 'guide'));
---
<Base title="Guides" description={description} active="guides">
  <StoryIndex kicker="Type" title="Guides" description={description} posts={posts} empty="No guides yet" />
</Base>
