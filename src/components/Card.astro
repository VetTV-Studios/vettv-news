---
import { CATS, TYPE_LABEL, url, asset, fmt, coverFile } from '../site';
const { post, variant = 'river', n } = Astro.props;
const d = post.data;
const href = url(`posts/${post.id}`);
const src = asset(coverFile(post));
const t = d.type && d.type !== 'news' ? d.type : '';
const cat = CATS[d.category];
---
{variant === 'most' ? (
  <li class="most-item">
    <a href={href}>
      <img src={src} alt="" width="1200" height="675" loading="lazy" />
      <span>
        <span class={`kick cat-${d.category}`}>{cat}</span>
        <span class="most-title">{d.title}</span>
      </span>
    </a>
  </li>
) : variant === 'lead' ? (
  <article class="section-lead">
    <a class="section-lead-media" href={href}><img src={src} alt="" width="1200" height="675" /></a>
    <div>
      <div class="meta"><a class={`kick cat-${d.category}`} href={url(d.category)}>{cat}</a>{t && <span class={`type type-${t}`}>{TYPE_LABEL[t]}</span>}{d.sample && <span class="pill sample">Sample</span>}</div>
      <h2><a href={href}>{d.title}</a></h2>
      <p>{d.description}</p>
      <div class="meta"><span class="by">{d.author}</span><time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time></div>
    </div>
  </article>
) : (
  <article class="river-item">
    <a class="river-media" href={href}><img src={src} alt="" width="1200" height="675" loading="lazy" /></a>
    <div>
      <div class="meta"><a class={`kick cat-${d.category}`} href={url(d.category)}>{cat}</a>{t && <span class={`type type-${t}`}>{TYPE_LABEL[t]}</span>}{d.sample && <span class="pill sample">Sample</span>}</div>
      <h3><a href={href}>{d.title}</a></h3>
      <p>{d.description}</p>
      <div class="meta byline"><span class="by">{d.author}</span><time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>{n ? <span class="muted">#{n}</span> : null}</div>
    </div>
  </article>
)}
