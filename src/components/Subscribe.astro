---
// Newsletter signup (Kit by default). Public env vars only, no secrets:
//   PUBLIC_NEWSLETTER_ACTION  Kit form URL: https://app.kit.com/forms/<FORM_ID>/subscriptions  (required; form shows "coming soon" if unset)
//   PUBLIC_NEWSLETTER_FIELD   email field name (default "email_address", Kit's field)
const env = import.meta.env;
const action = env.PUBLIC_NEWSLETTER_ACTION || '';
const field = env.PUBLIC_NEWSLETTER_FIELD || 'email_address';
if (!action && !(globalThis as any).__nlWarned) { (globalThis as any).__nlWarned = true;
  console.warn('[newsletter] PUBLIC_NEWSLETTER_ACTION is not set; signup forms render as "coming soon". Set it to https://app.kit.com/forms/<FORM_ID>/subscriptions'); }
const { id = 'sub', heading = 'Get the VetTV News weekly', compact = false } = Astro.props;
---
<section class={`subscribe ${compact ? 'compact' : ''}`} data-pagefind-ignore aria-labelledby={`${id}-h`}>
  <div class="sub-copy">
    <h2 id={`${id}-h`}>{heading}</h2>
    <p>One email every Sunday with the week's VetTV News stories: handhelds, PC, Linux, retro and more. No spam, unsubscribe anytime.</p>
  </div>
  {action ? (
    <form class="sub-form" action={action} method="post" target="_blank">
      <label for={`${id}-email`} class="sr">Email address</label>
      <input id={`${id}-email`} type="email" name={field} required placeholder="you@example.com" autocomplete="email" />
      <button type="submit">Subscribe</button>
    </form>
  ) : (
    <p class="sub-form sub-soon"><strong>Signups open soon.</strong> Follow along via <a href="/rss.xml">RSS</a> in the meantime.</p>
  )}
  <p class="sub-fine">You'll get a confirmation email first, and every issue has a one-click unsubscribe link. <a href="/newsletter/">What we send &amp; privacy</a>.</p>
</section>
