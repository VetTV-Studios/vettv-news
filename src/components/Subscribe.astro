---
// Provider-agnostic signup form. Configure with PUBLIC env vars (no secrets; these are public form endpoints):
//   PUBLIC_NEWSLETTER_ACTION   form POST URL   (default: Buttondown embed for VetTVStudios)
//   PUBLIC_NEWSLETTER_FIELD    email field name (default: "email"; Kit uses "email_address")
//   PUBLIC_NEWSLETTER_NAME     provider label   (default: "Buttondown")
//   PUBLIC_NEWSLETTER_HOME     provider archive/home link (optional)
const env = import.meta.env;
const action = env.PUBLIC_NEWSLETTER_ACTION || 'https://buttondown.com/api/emails/embed-subscribe/VetTVStudios';
const field = env.PUBLIC_NEWSLETTER_FIELD || 'email';
const provider = env.PUBLIC_NEWSLETTER_NAME || 'Buttondown';
const home = env.PUBLIC_NEWSLETTER_HOME || (action.includes('buttondown.com') ? 'https://buttondown.com/VetTVStudios' : '');
const isButtondown = action.includes('buttondown.com');
const { id = 'sub', heading = 'Get the VetTV News weekly', compact = false } = Astro.props;
---
<section class={`subscribe ${compact ? 'compact' : ''}`} data-pagefind-ignore aria-labelledby={`${id}-h`}>
  <div class="sub-copy">
    <h2 id={`${id}-h`}>{heading}</h2>
    <p>One email every Sunday with the week's VetTV News stories: handhelds, PC, Linux, retro and more. No spam, unsubscribe anytime.</p>
  </div>
  <form class="sub-form" action={action} method="post" target="_blank">
    <label for={`${id}-email`} class="sr">Email address</label>
    <input id={`${id}-email`} type="email" name={field} required placeholder="you@example.com" autocomplete="email" />
    {isButtondown && <input type="hidden" name="embed" value="1" />}
    <button type="submit">Subscribe</button>
  </form>
  <p class="sub-fine">You'll get a confirmation email first. <a href="/newsletter/">What we send &amp; privacy</a>{home && <> · Powered by <a href={home} target="_blank" rel="noopener">{provider}</a></>}.</p>
</section>
